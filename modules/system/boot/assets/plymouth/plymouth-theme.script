Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

frame_count = FRAME_COUNT_PLACEHOLDER;

// Get screen dimensions
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// Frames are sized at build time, so they're drawn 1:1 and centered
// on the black background (no runtime scaling: faster startup, far less RAM).
// ffmpeg outputs frame-1.png, frame-2.png ... (1-indexed)
for (i = 0; i < frame_count; i++)
  anim_image[i] = Image("frame-" + (i + 1) + ".png");

anim_sprite = Sprite(anim_image[0]);
anim_sprite.SetX(Math.Int((screen_width - anim_image[0].GetWidth()) / 2));
anim_sprite.SetY(Math.Int((screen_height - anim_image[0].GetHeight()) / 2));
anim_sprite.SetZ(0);

// Plymouth calls the refresh function at 50 Hz; advance one frame every N ticks.
ticks_per_frame = TICKS_PER_FRAME_PLACEHOLDER;
progress = 0;

fun refresh_callback() {
  anim_sprite.SetImage(anim_image[Math.Int(progress / ticks_per_frame) % frame_count]);
  progress++;
}

Plymouth.SetRefreshFunction(refresh_callback);
