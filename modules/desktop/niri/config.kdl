// ~/.dotfiles/modules/desktop/niri/config.kdl
// Niri's config. ~/.config/niri/config.kdl links here (see niri.nix), so
// changes saved in NiriMod or a text editor land in this repo right away.
// Niri reloads it live on save; `niri validate` checks it. Keep Nix store
// paths out of this file: anything that needs one goes in niri.nix.

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }
    mouse {
        accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="0%"

    touchpad

    trackpoint
}

// Hide the pointer while typing, like Plasma; it comes back on mouse move.
cursor {
    hide-when-typing
}

// Same layout as Plasma: the 1080p screen on the left, the ultrawide
// on the right, bottom edges lined up.
output "DP-3" {
    mode "1920x1080@60.000"
    scale 1
    position x=0 y=0
}
output "DP-1" {
    mode "3440x1440@143.923"
    scale 1.35
    position x=1920 y=13
}

layout {
    gaps 12
    center-focused-column "never"
    // A lone window sits in the middle (see niri-first-window-wide in niri.nix).
    always-center-single-column
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    // Fullscreen windows have no solid backdrop: niri.nix patches niri's
    // default for that. Don't add fullscreen-backdrop-color here until niri
    // ships it in a release (see the TODO in niri.nix).
    focus-ring {
        width 3
        active-color "#00aaff"
        inactive-color "#44475a"
    }
    border {
        off
    }
    // Glow, like the blue Breeze shadow in Plasma (plasma.nix): a
    // centered shadow in the focus-ring blue, dimmer on unfocused windows.
    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=0
        color "#00aaffcc"
        inactive-color "#00aaff40"
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

environment {
    // Qt apps use the Plasma theme, colors and icons (kdeglobals).
    QT_QPA_PLATFORMTHEME "kde"
    XDG_MENU_PREFIX "plasma-"
}

// Autostart entries (~/.config/autostart, /etc/xdg/autostart) run here
// too, through systemd: that covers the wallpaper picker and KWallet's
// unlock. KDE's password prompt is marked KDE-only, so niri.nix starts it
// as the niri-polkit-agent user service.

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}
window-rule {
    match app-id="org.kde.konsole"
    opacity 0.95
}
// Ghostty draws its own (undecorated) window, so niri would fill the focused
// one with a solid focus-ring-blue background and hide its transparency.
// Konsole lets niri decorate it, which skips that background on its own.
window-rule {
    match app-id="com.mitchellh.ghostty"
    draw-border-with-background false
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps (terminal keys match Plasma's)
    Mod+Return hotkey-overlay-title="Ghostty" { spawn "ghostty"; }
    Ctrl+Alt+T { spawn "konsole"; }
    Mod+E hotkey-overlay-title="Dolphin" { spawn "dolphin"; }
    Mod+K hotkey-overlay-title="Kate" { spawn "kate"; }
    Mod+B hotkey-overlay-title="Brave" { spawn "brave"; }
    Mod+Space hotkey-overlay-title="Wallpaper picker" { spawn "wallpaperpicker" "toggle"; }

    // Noctalia
    Mod+D hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+X hotkey-overlay-title="Power menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    // Volume of the focused app only (app-volume, see niri.nix)
    Mod+Alt+Up hotkey-overlay-title="App volume up" { spawn "app-volume" "up"; }
    Mod+Alt+Down hotkey-overlay-title="App volume down" { spawn "app-volume" "down"; }
    Mod+Alt+M hotkey-overlay-title="App mute" { spawn "app-volume" "mute"; }
    Mod+Alt+WheelScrollUp cooldown-ms=50 { spawn "app-volume" "up"; }
    Mod+Alt+WheelScrollDown cooldown-ms=50 { spawn "app-volume" "down"; }
    Shift+XF86AudioRaiseVolume { spawn "app-volume" "up"; }
    Shift+XF86AudioLowerVolume { spawn "app-volume" "down"; }
    Shift+XF86AudioMute        { spawn "app-volume" "mute"; }

    // Windows
    Mod+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }
    Mod+MouseMiddle { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+I     { focus-window-or-workspace-up; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }

    // Mouse wheel: Mod+wheel scrolls through columns, with Ctrl it
    // carries the column along. Workspaces are on Mod+Shift+wheel below.
    // The Left/Right ones are for tilt wheels.
    Mod+WheelScrollDown      { focus-column-right; }
    Mod+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollUp   { move-column-left; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+WheelScrollLeft      { focus-column-left; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // Monitors
    Mod+Ctrl+Left        { focus-monitor-left; }
    Mod+Ctrl+Right       { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces
    Mod+Page_Down       { move-column-to-workspace-down; }
    Mod+Page_Up         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up   { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // Column sizing
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { maximize-window-to-edges; }
    Mod+C       { center-column; }
    Mod+V       { toggle-window-floating; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }
    Mod+W       { toggle-column-tabbed-display; }

    // Screenshots
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }
    // Start/stop a silent recording of the focused monitor (screen-record, see niri.nix)
    Shift+Print hotkey-overlay-title="Toggle screen recording" { spawn "screen-record"; }

    // Session
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
}

animations

gestures {
    hot-corners {
        off
    }
}
